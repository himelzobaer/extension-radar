# .env এ কপি করে নিজের মান বসান। .env কখনো commit করবেন না।

# GitHub personal access token (public_repo read যথেষ্ট, কোনো scope না দিলেও চলে)
GITHUB_TOKEN=

# Google Sheet এর ID (URL এর /d/ আর /edit এর মাঝের অংশ)
SHEET_ID=

# Service account key: দুইটার যেকোনো একটা দিন
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

LOG_LEVEL=INFO
